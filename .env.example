# OpenSearch HTTPS API, not Dashboards (5601); trailing slash is optional.
OPENSEARCH_URL=https://localhost:9200
# TOKEN accepts an os_ API key or Bearer token; leave blank for basic authentication.
TOKEN=
# Optional basic authentication when TOKEN is blank.
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
# Verify certificates; the local cluster's CA is mounted by Compose.
OPENSEARCH_VERIFY_TLS=true
# Optional custom CA path inside the container; leave blank for public CAs.
OPENSEARCH_CA_FILE=/app/certs/opensearch-root-ca.pem
